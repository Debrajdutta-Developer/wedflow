generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  HOST
  FAMILY_MEMBER
  PHOTOGRAPHER
  GUEST
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum DietaryPreference {
  VEG
  NON_VEG
}

enum VendorStatus {
  PAID
  PENDING
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  role     UserRole
}

model Event {
  id              String   @id @default(cuid())
  title           String
  date            DateTime
  venue           String
  budgetLimit     Float
  currentExpenses Float @default(0)

  guestGroups     GuestGroup[]
  vendors         Vendor[]
  mediaAssets     MediaAsset[]
}

model GuestGroup {
  id                   String @id @default(cuid())
  groupName            String
  totalAllocatedPlates Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  guests Guest[]
}

model Guest {
  id                 String @id @default(cuid())
  name               String
  email              String?
  phone              String?
  checkedIn          Boolean @default(false)
  qrCodeHash         String
  dietaryPreference  DietaryPreference
  rsvpStatus         RSVPStatus

  groupId String
  group   GuestGroup @relation(fields: [groupId], references: [id])
}

model Vendor {
  id          String @id @default(cuid())
  name        String
  serviceType String
  cost        Float
  status      VendorStatus

  eventId String
  event   Event @relation(fields: [eventId], references: [id])
}

model MediaAsset {
  id             String @id @default(cuid())
  url            String
  uploadedByRole UserRole

  eventId String
  event   Event @relation(fields: [eventId], references: [id])
}
